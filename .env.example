# Copy the pooled connection string from Neon → Connect. Server only; never VITE_DATABASE_URL.
DATABASE_URL=
# Neon CLI populates this direct URL for migrations.
DATABASE_URL_UNPOOLED=
# Optional override for migrations.
DATABASE_URL_DIRECT=
API_PORT=3001
# Browser origins allowed to call the API. Add the deployed domain when hosting for real.
APP_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174
# Hostnames the API answers to (comma-separated). Unset = localhost/127.0.0.1 only (local development).
# On Vercel, api/[...path].js reads this and passes it as buildApp's allowedHosts.
ALLOWED_HOSTS=
# Waiters can only sign in from these public IPs/CIDRs (comma-separated). Empty = loopback only (local development).
WAITER_ALLOWED_IPS=
# Only behind a reverse proxy you control: hop count (1) or proxy IPs/CIDRs. Unset = use the socket address.
# Not read on Vercel — api/[...path].js always sets trustProxy: true there.
TRUST_PROXY=
