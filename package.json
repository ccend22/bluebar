{
  "name": "bluebar",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test src/domain.test.js server/*.test.js",
    "dev:web": "vite --host 127.0.0.1",
    "api": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "db:check": "node --env-file-if-exists=.env scripts/db-check.js",
    "auth:manager": "node --env-file-if-exists=.env scripts/create-manager.js"
  },
  "dependencies": {
    "@neon/config": "^1.7.2",
    "@neon/env": "^1.4.3",
    "@number-flow/react": "^0.6.2",
    "clsx": "^2.1.1",
    "fastify": "^5.12.5",
    "motion": "^14.0.0",
    "pg": "^8.23.0",
    "qrcode-generator": "^1.5.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "sonner": "^2.0.8"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "vite": "^7.0.0"
  },
  "engines": {
    "node": ">=22.16.0"
  }
}
